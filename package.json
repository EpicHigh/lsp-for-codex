{
  "name": "lsp-for-codex",
  "version": "0.1.0",
  "description": "Codex plugin that exposes local Language Server Protocol diagnostics and symbols through MCP.",
  "type": "module",
  "homepage": "https://github.com/EpicHigh/lsp-for-codex#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EpicHigh/lsp-for-codex.git"
  },
  "bugs": {
